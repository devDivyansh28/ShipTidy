# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/shiptidy?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your_better_auth_secret_32_characters"
BETTER_AUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# GitHub App
GITHUB_APP_ID="your_github_app_id"
NEXT_PUBLIC_GITHUB_LINK="https://github.com/apps/your-app-slug"
GITHUB_APP_NAME="your-github-app-slug"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"

# Inngest (Background Jobs)
INNGEST_DEV=1

# OpenRouter (AI Model Provider)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"

# Pinecone (Vector Database)
PINECONE_INDEX="shiptidy"
PINECONE_API_KEY="pcsk_your_pinecone_api_key"

# Razorpay (Subscription Billing)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_PLAN_ID="plan_your_plan_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
